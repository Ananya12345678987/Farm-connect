# Fill these in with your DEPLOYED backend's real URL once it's live,
# then set them as environment variables in your frontend host's dashboard
# (Vercel/Netlify) — do not rely on this file at deploy time, hosts read
# env vars from their own settings, not from .env files in the repo.
VITE_API_URL=https://your-backend.onrender.com/api
VITE_SOCKET_URL=https://your-backend.onrender.com